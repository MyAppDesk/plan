{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Measure: dev server + Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true,
      "preLaunchTask": "npm: dev",
      "postDebugTask": "kill dev server",
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-profile",
      "runtimeArgs": ["--auto-open-devtools-for-tabs"]
    },
    {
      "name": "Measure: attach to running dev server",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "sourceMaps": true
    },
    {
      "name": "Measure: preview production build",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4173",
      "webRoot": "${workspaceFolder}/dist",
      "preLaunchTask": "npm: preview"
    }
  ]
}
